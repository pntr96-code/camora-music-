<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>Camora | لوحة تحكم المالك</title>
    <style>
        body { background-color: #1e1f22; color: #ffffff; font-family: Tahoma, sans-serif; margin: 0; padding: 20px; }
        .header { display: flex; justify-content: space-between; align-items: center; background: #2b2d31; padding: 15px 30px; border-radius: 10px; margin-bottom: 20px; border: 1px solid #ed4245; }
        .badge { background: #ed4245; padding: 5px 10px; border-radius: 5px; font-size: 12px; font-weight: bold; }
        .stats-container { display: flex; gap: 20px; margin-bottom: 20px; }
        .stat-box { background: #2b2d31; padding: 20px; border-radius: 10px; flex: 1; text-align: center; border: 1px solid #35363c; }
        .stat-box h3 { margin: 0 0 10px 0; color: #949ba4; }
        .stat-box p { margin: 0; font-size: 24px; font-weight: bold; color: #5865F2; }
        .panel { background: #2b2d31; padding: 20px; border-radius: 10px; text-align: center; border: 1px solid #35363c; }
        .song-title { color: #1abc9c; font-size: 18px; margin: 15px 0; font-weight: bold; }
        .controls button { background-color: #5865F2; color: white; border: none; padding: 10px 15px; margin: 5px; border-radius: 5px; font-size: 16px; cursor: pointer; transition: 0.2s; }
        .controls button:hover { background-color: #4752C4; }
        .controls .btn-danger { background-color: #ed4245; }
        .controls .btn-danger:hover { background-color: #c03537; }
    </style>
</head>
<body>

    <div class="header">
        <h2>👑 لوحة تحكم المالك (Owner Panel)</h2>
        <div>
            <span class="badge">المالك فقط</span>
            &nbsp; | &nbsp;
            <a href="/dashboard" style="color: #1abc9c; text-decoration: none;">العودة للرئيسية</a>
        </div>
    </div>

    <div class="stats-container">
        <div class="stat-box">
            <h3>عدد الطوابير الشغالة حالياً 🎵</h3>
            <p><%= activeQueues %></p>
        </div>
        <div class="stat-box">
            <h3>حالة البوت 🟢</h3>
            <p style="color: #2ecc71;">متصل وجاهز</p>
        </div>
    </div>

    <div class="panel">
        <h3>التحكم الصوتي المركزي 🎛️</h3>
        <p>الأغنية الحالية:</p>
        <div class="song-title" id="currentSong">جاري جلب اسم المقطع...</div>
        
        <div class="controls">
            <button onclick="controlBot('pause')">⏸️ إيقاف مؤقت</button>
            <button onclick="controlBot('resume')">▶️ تشغيل</button>
            <button onclick="controlBot('skip')">⏭️ تخطي</button>
            <button onclick="controlBot('loop')">🔁 تكرار</button>
            <button class="btn-danger" onclick="controlBot('stop')">⏹️ إيقاف الصوت</button>
        </div>
    </div>

    <script>
        async function controlBot(action) {
            try {
                const response = await fetch('/api/control/' + action, { method: 'POST' });
                const data = await response.json();
                alert(data.message);
            } catch (err) {
                alert('❌ صار خطأ في الاتصال بالبوت!');
            }
        }

        async function updateSongName() {
            try {
                const res = await fetch('/api/current-song');
                const data = await res.json();
                document.getElementById('currentSong').innerText = data.title || 'لا يوجد مقطع يعمل حالياً';
            } catch (e) {}
        }
        setInterval(updateSongName, 3000);
        updateSongName();
    </script>

</body>
</html>